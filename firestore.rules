// ════════════════════════════════════════════════════════════════════════
// ⚠️ 이 파일 = Firebase 콘솔에 게시된 규칙의 사본 (2026-11-04 실장이 콘솔 규칙 탭에서 복사 → 그대로 동기화)
//   - 실제로 적용되는 것은 콘솔 규칙입니다. firebase.json에 firestore 설정이 없어 `firebase deploy`로는 올라가지 않습니다.
//   - 콘솔 규칙을 바꾸면 이 파일도 같은 내용으로 갱신하세요(어긋나면 옛 파일을 콘솔에 붙여넣는 사고 위험).
//   - 이 규칙에 기대는 기능: api/ceo-access-code.js(승인자만 법인 CEO 컨설팅 접속 코드) — users create=status 'pending'만 ·
//     본인 role/status 변경 불가 · isAdmin=users.role 'admin'. 이 세 가지를 느슨하게 바꾸지 말 것.
// ════════════════════════════════════════════════════════════════════════

// ============================================================
// Pro_MainDashboard (pro-enterprise-ai) Firestore 보안 규칙 — 엄격안
// 2026-06-06 작성. 콘솔 Rules 탭에 붙여넣기 → Playground 검증 → 게시.
// 게시 전 반드시: ① 현재(if true) 규칙 전체를 별도 백업 ② 아래 Playground 13케이스 통과 확인
// ============================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 사원 공개 lookup {uid,email,displayName}
    // - get: 가입·비번재설정에서 사원번호로 1건 조회(미인증 필요) → 허용
    // - list: 통째 덤프 차단(앱은 단일 get만 함)
    // - create: 로그인+본인 uid 문서만(가입 시). update/delete는 관리자(터미널은 owner=우회)
    match /employee_lookup/{empNo} {
      allow get:            if true;
      allow list:           if isAdmin();
      allow create:         if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 사용자 문서 (PII: phone/email/name/fingerprint)
    // - get: 본인 또는 관리자
    // - list: 관리자만(관리자 패널)
    // - create: 본인 + role='user' + status='pending' (자가 admin 승격 차단)
    // - update: 본인이되 role/status 불변(자가 승격 차단) / 또는 관리자(전체)
    // - delete: 관리자만
    match /users/{uid} {
      allow get:    if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list:   if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'user'
                    && request.resource.data.status == 'pending';
      allow update: if isSignedIn() && (
                      ( request.auth.uid == uid
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.status == resource.data.status )
                      || isAdmin()
                    );
      allow delete: if isAdmin();
    }

    // ═══ CEO 컨설팅 — 허용 명단(개별 설정: 관리자가 uid 문서에 { enabled, name, addedAt } 작성) ═══
    match /ceoConsultingAccess/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ═══ CEO 컨설팅 — 사용 가능 여부(2026-10-20): 개별 설정이 있으면 그 값, 없으면 대시보드 승인자 ═══
    function ceoCanSync(uid) {
      return (exists(/databases/$(database)/documents/ceoConsultingAccess/$(uid))
                && get(/databases/$(database)/documents/ceoConsultingAccess/$(uid)).data.enabled == true)
          || (!exists(/databases/$(database)/documents/ceoConsultingAccess/$(uid))
                && get(/databases/$(database)/documents/users/$(uid)).data.status == 'approved');
    }

    // ═══ CEO 컨설팅 — 서버 저장 사용자 기록(2026-10-21): 본인만 {app, name, lastSavedAt} 쓰기, 관리자 목록 읽기 ═══
    match /ceoConsulting/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && ceoCanSync(uid)
                            && request.resource.data.keys().hasOnly(['app', 'name', 'lastSavedAt'])
                            && request.resource.data.app == 'ceo-consulting'
                            && request.resource.data.name is string && request.resource.data.name.size() <= 40
                            && request.resource.data.lastSavedAt is string && request.resource.data.lastSavedAt.size() <= 40;
    }

    // ═══ CEO 컨설팅 — 법인 명단 (본인 uid 아래, 사용 가능할 때만) ═══
    match /ceoConsulting/{uid}/companies/{companyId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && ceoCanSync(uid)
                         && (!(request.method in ['create', 'update'])
                             || (request.resource.data.app == 'ceo-consulting'
                                 && request.resource.data.profile is map
                                 && request.resource.data.size() <= 12));
      allow read: if isAdmin();
    }

    // 그 외 모든 경로 전면 차단
    match /{document=**} { allow read, write: if false; }
  }
}
